{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Qiskit: single circuit (5xp1)",
      "type": "debugpy",
      "request": "launch",
      "module": "eda_hub.pages.qiskit.cli",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "args": ["--circuit", "5xp1"]
    },
    {
      "name": "Qiskit: local ESOP file",
      "type": "debugpy",
      "request": "launch",
      "module": "eda_hub.pages.qiskit.cli",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "args": [
        "--file",
        "${workspaceFolder}/benchmarks/mcnc/Combinational/pla/All_PLAs/5xp1.esop"
      ]
    },
    {
      "name": "Python: RPLA (rpla.py)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/python/rpla.py",
      "cwd": "${workspaceFolder}/python",
      "console": "integratedTerminal"
    },
    {
      "name": "Python: Optimized RPLA (demo harness)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/python/optimized_rpla_calculation.py",
      "cwd": "${workspaceFolder}/python",
      "console": "integratedTerminal",
      "args": []
    }
  ]
}
